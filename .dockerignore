# Mantén el contexto de build pequeño: la imagen solo necesita backend/ +
# requirements-backend.txt + alembic.ini + docker/.

# Entorno virtual checked-in (enorme, NO debe entrar)
env/
venv/
.venv/

# Cliente de escritorio (GUI) y app móvil — no van en la imagen del backend
desktop_app/
CamLink_app/

# Datos y artefactos pesados / generados
data/
recordings/
**/recordings/
*.pt
*.onnx
*.engine
**/debug_snapshots/
**/snapshot_*.jpg
go2rtc.generated.yaml

# Caches y temporales
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Control de versiones / IDE / docs
.git/
.gitignore
.claude/
*.md
docs/
*.avif
*.jpg
*.jpeg
*.png

# Tests ad-hoc (no necesarios en runtime)
backend/tests/

# Secretos locales (el contenedor usa .env.docker vía env_file, no .env)
.env
