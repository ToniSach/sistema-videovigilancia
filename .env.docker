# ============================================================================
# Variables para el despliegue con Docker (docker-compose.yml).
# Cópialo/edítalo antes del primer arranque.
#
#   ⚠️  CAMBIA LOS SECRETOS antes de usarlo en serio:
#       python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# ----- PostgreSQL (lo usan el contenedor db y el backend) -----
POSTGRES_DB=nvr_db
POSTGRES_USER=nvr_user
POSTGRES_PASSWORD=cambia_esta_password

# ----- Secretos de la app (¡CÁMBIALOS!) -----
SECRET_KEY=cambia-esta-clave-por-una-larga-y-unica
JWT_SECRET_KEY=cambia-este-jwt-por-uno-largo-y-unico
# Pon APP_ENV=production cuando ya hayas definido secretos reales (exige que
# SECRET_KEY/JWT_SECRET_KEY no sean los de por defecto).
APP_ENV=development

# ----- IA (opcional): cámara única donde corre YOLO -----
# AI_CAMERA_ID=1

# ----- Telegram (opcional): se puede configurar luego desde la app -----
# TELEGRAM_BOT_TOKEN=123456789:AA...

# ----- Almacenamiento -----
MAX_STORAGE_GB=50

# ----- Red (WebRTC) -----
# IP LAN del PC donde corre Docker (ej. 192.168.1.50). Solo necesaria para
# WebRTC; HLS y RTSP funcionan sin esto. Averíguala con `ipconfig` (Windows).
HOST_LAN_IP=
