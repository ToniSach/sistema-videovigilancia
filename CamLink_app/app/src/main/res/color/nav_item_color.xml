<?xml version="1.0" encoding="utf-8"?>
<!-- Tinte de icono + texto de la barra inferior: acento si está seleccionado,
     gris apagado si no. Lo usan app:itemIconTint y app:itemTextColor. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/accent_cyan" android:state_checked="true" />
    <item android:color="@color/text_secondary" />
</selector>
