<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ── VIDEO ── -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_camera_feed">

        <!-- Selector de lente (solo dual-lens). Recorta el vídeo combinado al
             lente elegido en el cliente (sin re-descarga ni transcode). -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLensToggle"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Lente 1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone"
            app:backgroundTint="#66000000"
            app:cornerRadius="14dp" />
    </FrameLayout>

    <!-- ── CONTROLES (glass card) ── -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/controlsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        style="@style/Widget.CamLink.GlassCard"
        app:contentPadding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progressTint="@color/accent_cyan"
                android:thumbTint="@color/accent_cyan"
                android:progressBackgroundTint="@color/glass_border_strong" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnPrevious"
                    style="@style/Widget.CamLink.IconButton"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/track_previous"
                    android:src="@drawable/ic_skip_previous" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    style="@style/Widget.CamLink.IconButton"
                    android:contentDescription="@string/btn_play"
                    android:src="@drawable/ic_play" />

                <ImageButton
                    android:id="@+id/btnNext"
                    style="@style/Widget.CamLink.IconButton"
                    android:layout_marginStart="24dp"
                    android:contentDescription="@string/track_next"
                    android:src="@drawable/ic_skip_next" />

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
