<?xml version="1.0" encoding="utf-8"?>
<!-- Segmento de grabación en el timeline: [▶] hora · duración · tipo -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp"
    app:rippleColor="@color/accent_cyan">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <FrameLayout
            android:id="@+id/playWrap"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_play_circle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="10dp"
                android:src="@drawable/ic_play"
                app:tint="@color/primary_dark"
                android:contentDescription="@string/btn_play" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSegTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="03:15:24"
            app:layout_constraintStart_toEndOf="@id/playWrap"
            app:layout_constraintEnd_toStartOf="@id/tvSegBadge"
            app:layout_constraintTop_toTopOf="@id/playWrap" />

        <TextView
            android:id="@+id/tvSegSub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="0:20 · 1.2 MB"
            app:layout_constraintStart_toEndOf="@id/playWrap"
            app:layout_constraintEnd_toStartOf="@id/tvSegBadge"
            app:layout_constraintTop_toBottomOf="@id/tvSegTime" />

        <TextView
            android:id="@+id/tvSegBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/primary_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="EVENTO"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
