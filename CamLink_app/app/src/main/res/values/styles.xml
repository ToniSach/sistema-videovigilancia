<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base styles (placeholders para futuros sub-estilos) -->
    <style name="Widget.CamLink" parent="android:Widget" />
    <style name="TextAppearance.CamLink" parent="TextAppearance.AppCompat" />

    <!-- Round icon button (bordered) -->
    <style name="Widget.CamLink.IconButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">8dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <!-- Recording row label -->
    <style name="TextAppearance.CamLink.RecordingLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- ============================================================
         Estilos del tema slate (replica desktop_app GlassCard / acento)
         ============================================================ -->

    <!-- Card "glass" — fondo surface con borde sutil y esquinas redondeadas. -->
    <style name="Widget.CamLink.GlassCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/glass_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">16dp</item>
    </style>

    <!-- Botón "primary" — relleno con acento celeste -->
    <style name="Widget.CamLink.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent_cyan</item>
        <item name="android:textColor">@color/primary_dark</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Botón "outlined" — borde slate-400, fondo transparente -->
    <style name="Widget.CamLink.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/glass_border_strong</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="cornerRadius">8dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Texto título (sección o card header) -->
    <style name="TextAppearance.CamLink.Title">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- EditText con fondo surface y borde sutil -->
    <style name="Widget.CamLink.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_edit_text</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:padding">12dp</item>
    </style>

</resources>
