# ============================================================================
# CONFIGURACIÓN DEL SISTEMA NVR/VMS  —  PLANTILLA (sin secretos reales)
#
# Cópialo a «.env» y ajusta los valores:
#     copy .env.example .env      (Windows)
#     cp   .env.example .env      (Linux/Mac)
#
# El backend lee «.env» del raíz del repo. TODAS las variables tienen un valor
# por defecto razonable en el código; aquí están documentadas para que puedas
# cambiarlas sin tocar el código.
#
# ⚠️  NUNCA subas tu «.env» real al control de versiones ni a la entrega: contiene
#     claves JWT, el token del bot de Telegram y la contraseña de PostgreSQL.
# ============================================================================

# ----------------------------------------------------------------------------
# SEGURIDAD  (¡GENERA estos secretos para cualquier despliegue real!)
#   Genera valores únicos:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# ----------------------------------------------------------------------------
SECRET_KEY=cambia-esta-clave-por-una-larga-y-unica
JWT_SECRET_KEY=cambia-este-jwt-por-uno-largo-y-unico
# development | production  (en production se EXIGE no usar los secretos por defecto)
APP_ENV=development
# Pon true para permitir secretos por defecto en production (NO recomendado)
ALLOW_DEFAULT_SECRETS=false

# Tiempos de vida de los JWT
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=30

# Firma de URLs de medios (playback/snapshots). Vacío = usa JWT_SECRET_KEY.
MEDIA_URL_SECRET=
MEDIA_URL_TTL_SECONDS=3600

# ----------------------------------------------------------------------------
# BASE DE DATOS  (PostgreSQL — la BD activa; SQLite es legacy/no se usa)
#   Crea el rol y la BD con: Entrega/BaseDatos/crear_bd.sql
#   Restaura el respaldo con: Entrega/BaseDatos/RESTAURACION.md
# ----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nvr_db
POSTGRES_USER=nvr_user
POSTGRES_PASSWORD=cambia-esta-password
# Pool de conexiones
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_TIMEOUT=30

# ----------------------------------------------------------------------------
# SERVIDOR (API REST + WebSocket)
# ----------------------------------------------------------------------------
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
LOG_LEVEL=INFO

# ----------------------------------------------------------------------------
# ALMACENAMIENTO  (también configurable en caliente desde la app de escritorio)
# ----------------------------------------------------------------------------
# Ruta de grabaciones. Recomendado FUERA de OneDrive para evitar bloqueos de
# archivo (p.ej. C:\nvr_data\recordings).
RECORDINGS_PATH=recordings
# Cuota máxima de disco para grabaciones (GB). Al superarse, se borra lo más viejo.
MAX_STORAGE_GB=50
# Iniciar grabación continua automáticamente al arrancar cada cámara
AUTO_START_RECORDING=true
# Tamaño máximo por archivo de grabación antes de cortar segmento
RECORDING_MAX_FILE_SIZE=500
# Grabación sin recodificar (-c copy): mucho menos CPU. Recomendado true.
RECORDING_COPY_MODE=true

# ----------------------------------------------------------------------------
# CÁMARAS / FFmpeg
# ----------------------------------------------------------------------------
MAX_CAMERAS=4
MAX_CONCURRENT_FFMPEG=4
# Transporte RTSP: tcp (robusto, recomendado) | udp
RTSP_TRANSPORT=tcp
# Resolución/FPS objetivo para cámaras de un solo lente
FFMPEG_RESOLUTION_WIDTH=1280
FFMPEG_RESOLUTION_HEIGHT=720
FFMPEG_FPS=15
# Tamaño RAW del stream dual-lens ANTES de dividir (dos 720p apilados = 1280x1440)
FFMPEG_DUAL_LENS_WIDTH=1280
FFMPEG_DUAL_LENS_HEIGHT=1440
# Sincronizar la hora de la cámara por ONVIF al arrancar
CAMERA_SYNC_TIME_ON_START=true
# Ocultar cámaras inactivas en la vista en vivo (?live=1)
LIVE_HIDE_INACTIVE_CAMERAS=false

# ----------------------------------------------------------------------------
# INTELIGENCIA ARTIFICIAL (YOLOv8)
#   Solo UNA cámara corre IA a la vez (la indicada por AI_CAMERA_ID; si está
#   vacío, se elige al activar la IA desde la app). Las NOTIFICACIONES solo
#   existen para la cámara con IA activa.
# ----------------------------------------------------------------------------
AI_CAMERA_ID=
MAX_AI_INFERENCE_QUEUE=10
# auto | true | false
USE_GPU_AI=auto
# auto | cuda | cpu
AI_BACKEND=auto
# Modelo YOLO (yolov8n.pt = ligero; yolo11n.pt = más preciso a igual coste)
AI_MODEL=yolov8n.pt
# auto | openvino | onnx | pytorch  (auto = OpenVINO en CPU, PyTorch en GPU)
AI_FORMAT=auto
# Tamaño de inferencia (640 = sin perder precisión; 320 = ~4x más rápido)
AI_IMGSZ=640
# Hilos de torch (0 = automático)
AI_TORCH_THREADS=0
# Umbral de confianza (0.0-1.0)
AI_CONFIDENCE=0.35
# Intervalo de inferencia: 1 de cada N frames (low=ahorro CPU, high=más rápido)
AI_INFERENCE_INTERVAL_LOW=5
AI_INFERENCE_INTERVAL_HIGH=3
# Sensibilidad del detector de movimiento (fracción de píxeles cambiados)
AI_MOTION_SENSITIVITY=0.015
# Cooldown entre alertas de la misma clase (segundos)
AI_EVENT_COOLDOWN_SECONDS=30
# "Movimiento general" (movimiento sin persona/vehículo): cooldown LARGO para no
# inundar de notificaciones, y score mínimo para ignorar micro-movimientos.
AI_MOTION_NOTIFY_COOLDOWN=120
AI_MOTION_NOTIFY_MIN_SCORE=0.06

# ----------------------------------------------------------------------------
# go2rtc / WebRTC  (capa de directo: WebRTC/RTSP/HLS directo al cliente)
# ----------------------------------------------------------------------------
# go2rtc es la ÚNICA vía de directo (MJPEG fue eliminado). Déjalo activado.
GO2RTC_ENABLED=true
# Ruta o nombre en PATH del binario go2rtc (en el repo: ./go2rtc.exe)
GO2RTC_BINARY=go2rtc
GO2RTC_API_HOST=0.0.0.0
GO2RTC_API_PORT=1984
GO2RTC_RTSP_PORT=8554
GO2RTC_WEBRTC_PORT=8555
# IP LAN anunciada a los clientes (vacío = autodetectar). Útil con varias NICs.
GO2RTC_PUBLIC_HOST=
# Candidatos ICE extra (coma-separados) para acceso remoto; vacío = solo LAN
GO2RTC_WEBRTC_CANDIDATES=
# Aceleración por hardware del transcodificado de go2rtc: '' | qsv | nvenc | vaapi
GO2RTC_HWACCEL=
# El FFmpegWorker (IA/grabación) lee del restream de go2rtc en vez de la cámara
# directa. CRÍTICO para cámaras que solo aceptan 1 conexión RTSP (XiongMai).
GO2RTC_AS_SOURCE=true
# Señalización WebRTC (WHEP) en el backend. Requiere GO2RTC_ENABLED.
WEBRTC_ENABLED=false

# ----------------------------------------------------------------------------
# TELEGRAM  (opcional; se puede configurar también desde la app de escritorio)
#   Las notificaciones push por FCM/Firebase fueron ELIMINADAS: el móvil recibe
#   alertas por WebSocket en la LAN, sin internet.
#   Obtén un token con @BotFather y tu chat_id con @userinfobot.
# ----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Cooldown anti-spam de Telegram (segundos): como mucho 1 notificación por
# (cámara, tipo de evento) cada N s.
TELEGRAM_NOTIFY_COOLDOWN=60

# ----------------------------------------------------------------------------
# TELEMETRÍA integrada (arranca con el backend; escribe en telemetry/)
# ----------------------------------------------------------------------------
TELEMETRY_ENABLED=true
TELEMETRY_INTERVAL=2.0
